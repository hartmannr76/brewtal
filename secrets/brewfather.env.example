# Brewfather credentials for local builds that talk to Brewfather (the board test env).
# Copy this file to secrets/brewfather.env and fill in THAT copy (it is ignored by git). Leave this
# template empty: it is tracked. Never commit the filled-in copy or paste the values anywhere else.
#
# BF_USER_ID    Brewfather: Settings > API > User ID
# BF_API_KEY    Brewfather: Settings > API keys > Manage > Create API key (scope: batches.read)
# BF_STREAM_ID  Brewfather: Settings > Power-ups > Custom Stream: the id from the logging URL
#               (the part after ?id= ; pasting the whole URL also works)
BF_USER_ID=
BF_API_KEY=
BF_STREAM_ID=
